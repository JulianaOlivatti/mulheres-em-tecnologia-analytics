      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 18px;
      padding: 28px 24px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.42);
      display: flex;
      flex-direction: column;
      transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      position: relative;
      overflow: hidden;
    }

    .pillar-card-block::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, #f59e0b, #c25e38);
      opacity: 0.9;
    }

    .pillar-card-block:hover {
      transform: translateY(-5px);
      border-color: rgba(245, 158, 11, 0.55);
      box-shadow: 0 22px 48px rgba(0, 0, 0, 0.55), 0 0 24px rgba(245, 158, 11, 0.18);
      background: rgba(24, 20, 18, 0.82);
    }

    .pillar-header-row {
      display: flex;
      align-items: baseline;
      gap: 12px;
      margin-bottom: 10px;
      border-bottom: 1px solid rgba(254, 243, 199, 0.2);
      padding-bottom: 8px;
    }

    .pillar-num-badge {
      font-family: var(--font-serif);
      font-size: 2.1rem;
      font-weight: 700;
      color: #f59e0b;
      line-height: 1;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    }

    .pillar-main-title {
      font-family: var(--font-serif);
      font-size: 1.8rem;
      font-weight: 700;
      color: #ffffff;
      line-height: 1.2;
      text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
    }

    .pillar-highlight-stat {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(245, 158, 11, 0.18);
      border: 1px solid rgba(245, 158, 11, 0.4);
      color: #fef3c7;
      padding: 4px 12px;
      border-radius: 9999px;
      font-size: 0.76rem;
      font-weight: 700;
      margin-bottom: 14px;
      width: fit-content;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.8);
    }

    .pillar-lead-text {
      font-size: 0.92rem;
      line-height: 1.65;
      color: #f5f5f4;
      margin-bottom: 16px;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
    }

    .pillar-points-list {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .pillar-point-item {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 0.86rem;
      color: #e7e5e4;
      line-height: 1.55;
    }

    .point-gold-bullet {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #f59e0b;
      margin-top: 7px;
      flex-shrink: 0;
      box-shadow: 0 0 6px rgba(245, 158, 11, 0.8);
    }

    .point-bold-label {
      font-weight: 700;
      color: #fde68a;
    }

    /* ========================================================
       8. PARTE 03: DASHBOARD POWER BI & KPIS FLUTUANTES
       ======================================================== */
    .kpi-floating-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
      margin-bottom: 22px;
    }

    .kpi-floating-stat {
      background: rgba(18, 15, 13, 0.68);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 14px;
      padding: 16px 18px;
      text-align: center;
      transition: all 0.3s ease;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.35);
    }

    .kpi-floating-stat:hover {
      transform: translateY(-4px);
      border-color: rgba(245, 158, 11, 0.5);
      background: rgba(24, 20, 18, 0.78);
    }

    .kpi-big-num {
      font-family: var(--font-serif);
      font-size: 2.5rem;
      font-weight: 700;
      line-height: 1;
      margin-bottom: 4px;
    }

    .kpi-big-num.gold { color: #f59e0b; text-shadow: 0 2px 10px rgba(245, 158, 11, 0.4); }
    .kpi-big-num.terracotta { color: #e07a52; text-shadow: 0 2px 10px rgba(224, 122, 82, 0.4); }
    .kpi-big-num.white { color: #ffffff; text-shadow: 0 2px 10px rgba(255, 255, 255, 0.4); }

    .kpi-stat-label {
      font-size: 0.84rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 2px;
    }

    .kpi-stat-sub {
      font-size: 0.72rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .dashboard-glass-container {
      background: rgba(14, 11, 10, 0.78);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.55);
      margin-bottom: 20px;
    }

    .dashboard-toolbar-glass {
      padding: 12px 24px;
      background: rgba(255, 255, 255, 0.05);
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
    }

    .glass-tabs-nav {
      display: flex;
      gap: 8px;
    }

    .glass-tab-btn {
      background: transparent;
      border: 1px solid rgba(255, 255, 255, 0.2);
      color: #ffffff;
      padding: 7px 16px;
      border-radius: 9999px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .glass-tab-btn:hover {
      background: rgba(255, 255, 255, 0.12);
    }

    .glass-tab-btn.active {
      background: var(--color-terracotta);
      border-color: var(--color-terracotta);
      box-shadow: 0 2px 10px rgba(194, 94, 56, 0.5);
    }

    .glass-action-btn {
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid rgba(255, 255, 255, 0.22);
      color: #ffffff;
      padding: 6px 14px;
      border-radius: 8px;
      font-size: 0.78rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .glass-action-btn:hover {
      background: var(--color-terracotta);
      border-color: var(--color-terracotta);
    }

    .dashboard-content-area {
      min-height: 440px;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 34px 24px;
      text-align: center;
    }

    .pbi-service-replica {
      max-width: 680px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .pbi-logo-circle {
      width: 64px;
      height: 64px;
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.4);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .pbi-hero-title {
      font-family: var(--font-serif);
      font-size: 2.1rem;
      font-weight: 700;
      color: #ffffff;
      margin-bottom: 8px;
    }

    .pbi-hero-desc {
      font-size: 0.94rem;
      color: #e5e5e5;
      margin-bottom: 22px;
      line-height: 1.6;
    }

    .pbi-connect-button {
      background: #c25e38;
      color: white;
      border: none;
      padding: 12px 28px;
      border-radius: 9999px;
      font-size: 0.92rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      transition: all 0.25s ease;
      box-shadow: 0 4px 14px rgba(194, 94, 56, 0.4);
    }

    .pbi-connect-button:hover {
      background: #a24b2a;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(194, 94, 56, 0.6);
    }

    .pbi-safe-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: rgba(255, 255, 255, 0.65);
      font-size: 0.76rem;
      margin-top: 14px;
    }

    /* ========================================================
       9. PARTE 04: MÓDULO FUTURO / PLANEJAMENTO ESTRATÉGICO
       ======================================================== */
    .card-parte4-inner {
      text-align: center;
      max-width: 900px;
      margin: 40px auto;
      padding: 50px 30px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 22px;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
    }

    .future-module-icon {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: rgba(245, 158, 11, 0.15);
      border: 1px solid rgba(245, 158, 11, 0.4);
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 20px;
      color: #f59e0b;
    }

    .future-module-title {
      font-family: var(--font-serif);
      font-size: 2.3rem;
      color: #ffffff;
      margin-bottom: 12px;
    }

    .future-module-desc {
      font-size: 1rem;
      color: #d6d3d1;
      line-height: 1.7;
      max-width: 700px;
      margin: 0 auto 24px;
    }

    /* Rodapés de Rolagem */
    .hero-footer-hint {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: rgba(254, 243, 199, 0.85);
      font-size: 0.78rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      font-weight: 600;
      margin-top: 18px;
      text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);
    }

    /* Modal Power BI */
    .modal-backdrop {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(6px);
      z-index: 3500;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .modal-backdrop.active {
      display: flex;
    }

    .modal-card {
      background: #1c1917;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 16px;
      width: 100%;
      max-width: 540px;
      padding: 28px;
      color: white;
    }

    .modal-card h3 {
      font-family: var(--font-serif);
      font-size: 1.8rem;
      margin-bottom: 8px;
    }

    .modal-card input {
      width: 100%;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 12px 16px;
      border-radius: 8px;
      color: white;
      font-size: 0.9rem;
      margin: 14px 0;
    }

    .modal-card button {
      background: var(--color-terracotta);
      border: none;
      color: white;
      padding: 10px 20px;
      border-radius: 9999px;
      font-weight: 700;
      cursor: pointer;
    }

    /* ========================================================
       10. SISTEMA DE ANIMAÇÕES DE ROLAGEM (SCROLL REVEAL)
       ======================================================== */
    .scroll-reveal {
      opacity: 0;
      transform: translateY(32px);
      transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .scroll-reveal.is-visible {
      opacity: 1;
      transform: translateY(0);
    }

    .scroll-reveal-scale {
      opacity: 0;
      transform: scale(0.95) translateY(24px);
      transition: opacity 0.95s cubic-bezier(0.16, 1, 0.3, 1),
                  transform 0.95s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: opacity, transform;
    }

    .scroll-reveal-scale.is-visible {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    .stagger-1 { transition-delay: 0.1s; }
    .stagger-2 { transition-delay: 0.22s; }
    .stagger-3 { transition-delay: 0.35s; }
    .stagger-4 { transition-delay: 0.48s; }

    /* ========================================================
       RESPONSIVIDADE
       ======================================================== */
    @media (max-width: 1024px) {
      .topics-pure-grid, .diagnostico-pillars-flow {
        grid-template-columns: 1fr;
        gap: 26px;
      }
      .kpi-floating-row {
        grid-template-columns: repeat(2, 1fr);
      }
      .section-hero-title {
        font-size: 3rem;
      }
      .floating-scroll-dots {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .site-nav {
        display: none;
      }
      .section-inner-container {
        padding: 85px 20px 40px;
        min-height: auto;
      }
      .section-hero-title {
        font-size: 2.5rem;
      }
      .hero-highlight-text {
        font-size: 1.2rem;
        white-space: normal;
      }
      .kpi-floating-row {
        grid-template-columns: 1fr;
      }
      /* Em telas pequenas de celular, desativa sticky para rolagem natural */
      .card-stack-section {
        position: relative !important;
        top: auto !important;
        min-height: auto;
        border-radius: 20px 20px 0 0 !important;
      }
    }
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
