      }
      .hero-highlight-text {
        font-size: 1.2rem;
        white-space: normal;
      }
      .kpi-floating-row {
        grid-template-columns: 1fr;
      }
      /* Em telas pequenas de celular, desativa sticky para rolagem natural */
      .card-stack-section {
        position: relative !important;
        top: auto !important;
        min-height: auto;
        border-radius: 20px 20px 0 0 !important;
      }
    }
