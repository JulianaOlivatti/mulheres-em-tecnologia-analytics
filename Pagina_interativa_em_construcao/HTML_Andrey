      }
      .section-hero-title {
        font-size: 3rem;
      }
      .floating-scroll-dots {
        display: none;
      }
    }

    @media (max-width: 768px) {
      .site-nav {
        display: none;
      }
      .section-inner-container {
        padding: 85px 20px 40px;
        min-height: auto;
      }
      .section-hero-title {
