  <style>
    /* ========================================================
       DESIGN SYSTEM MAISON SCANDI & CARTÕES SOBREPOSTOS
       ======================================================== */
    :root {
      --font-serif: 'Cormorant Garamond', 'Playfair Display', Georgia, serif;
      --font-display: 'Playfair Display', Georgia, serif;
      --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

      --bg-dark: #0c0a09;
      --bg-card-dark: rgba(18, 15, 13, 0.76);
      --border-glass: rgba(255, 255, 255, 0.16);

      --color-terracotta: #c25e38;
      --color-terracotta-dark: #9a4323;
      --color-gold: #f59e0b;
      --color-amber-light: #fef3c7;
      --color-cream: #faf7f2;
      --color-muted: #a8a29e;

      --card-radius: 36px;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      font-size: 16px;
      scroll-behavior: smooth;
      background-color: var(--bg-dark);
      -webkit-font-smoothing: antialiased;
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-dark);
      color: #ffffff;
      line-height: 1.6;
      overflow-x: hidden;
    }

    /* ========================================================
       1. BARRA DE PROGRESSO DE ROLAGEM
       ======================================================== */
    .scroll-progress-track {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 3.5px;
      background: rgba(255, 255, 255, 0.08);
      z-index: 3000;
      pointer-events: none;
    }

    .scroll-progress-indicator {
      height: 100%;
      width: 0%;
      background: linear-gradient(90deg, #c25e38, #f59e0b, #fed7aa);
      box-shadow: 0 0 14px rgba(245, 158, 11, 0.9);
      transition: width 0.08s ease-out;
    }

    /* ========================================================
       2. CABEÇALHO TRANSPARENTE FIXO (TRANSLÚCIDO AO ROLAR)
       ======================================================== */
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      width: 100%;
      z-index: 2000;
      background: transparent;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      transition: background 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    }

    .site-header.scrolled {
      background: rgba(14, 11, 10, 0.76);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
    }

    .header-container {
      max-width: 1360px;
      margin: 0 auto;
      padding: 14px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .brand-wrapper {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: #ffffff;
    }

    .brand-icon {
      width: 36px;
      height: 36px;
      border-radius: 9px;
      background-color: var(--color-terracotta);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 10px rgba(194, 94, 56, 0.45);
      transition: transform 0.3s ease;
    }

    .brand-wrapper:hover .brand-icon {
      transform: rotate(-8deg) scale(1.06);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-family: var(--font-display);
      font-size: 1.15rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: #ffffff;
      line-height: 1.1;
      text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7);
    }

    .brand-tagline {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--color-amber-light);
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
    }

    .header-center-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: rgba(245, 158, 11, 0.14);
      border: 1px solid rgba(245, 158, 11, 0.35);
      color: #fed7aa;
      padding: 4px 14px;
      border-radius: 9999px;
      font-size: 0.74rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    .site-nav {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .nav-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 16px;
      border-radius: 9999px;
      font-size: 0.84rem;
      font-weight: 500;
      color: rgba(255, 255, 255, 0.88);
      text-decoration: none;
      text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
      transition: all 0.25s ease;
    }

    .nav-link:hover {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.16);
      transform: translateY(-1px);
    }

    .nav-link.active {
      color: #ffffff;
      background-color: rgba(255, 255, 255, 0.22);
      font-weight: 700;
      border: 1px solid rgba(255, 255, 255, 0.38);
    }

    .nav-link-num {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--color-amber-light);
    }

    .header-cta-btn {
      background: rgba(255, 255, 255, 0.18);
      color: #ffffff;
      border: 1px solid rgba(255, 255, 255, 0.35);
      padding: 8px 18px;
      border-radius: 9999px;
      font-size: 0.82rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.25s ease;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
    }

    .header-cta-btn:hover {
      background: var(--color-terracotta);
      border-color: var(--color-terracotta);
      transform: translateY(-2px);
      box-shadow: 0 4px 14px rgba(194, 94, 56, 0.4);
    }

    /* ========================================================
       3. NAVEGAÇÃO LATERAL FLUTUANTE (FLOATING DOTS)
       ======================================================== */
    .floating-scroll-dots {
      position: fixed;
      right: 24px;
      top: 50%;
      transform: translateY(-50%);
      z-index: 2500;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .scroll-dot {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 12px;
      text-decoration: none;
      color: white;
    }

    .dot-label {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: rgba(18, 15, 13, 0.88);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      padding: 4px 10px;
      border-radius: 9999px;
      opacity: 0;
      transform: translateX(10px);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
      white-space: nowrap;
    }

    .scroll-dot:hover .dot-label {
      opacity: 1;
      transform: translateX(0);
    }

    .dot-circle {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.35);
      border: 1px solid rgba(255, 255, 255, 0.6);
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .scroll-dot:hover .dot-circle {
      background: #fed7aa;
      transform: scale(1.3);
    }

    .scroll-dot.active .dot-circle {
      background: #f59e0b;
      border-color: #ffffff;
      transform: scale(1.4);
      box-shadow: 0 0 12px rgba(245, 158, 11, 0.9);
    }

    /* ========================================================
       4. EFEITO DE CARTÕES SOBREPOSTOS (STACKING CARDS SYSTEM)
       ======================================================== */
    .cards-stack-wrapper {
      position: relative;
      width: 100%;
    }

    .card-stack-section {
      position: sticky;
      top: 0;
